#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
INIT_SKILL="$ROOT/skills/init/SKILL.md"

if [[ ! -f "$INIT_SKILL" ]]; then
  printf '{"additionalContext":"cwork session-start: init skill not found"}\n'
  exit 0
fi

content="$(cat "$INIT_SKILL")"
content="${content//\\/\\\\}"
content="${content//\"/\\\"}"
content="${content//$'\n'/\\n}"

msg="<CWORK_SESSION_START>你有 cwork 技能集。若是多工程微服务需求，先执行 cwork-init。\\n\\n${content}</CWORK_SESSION_START>"

printf '{"additionalContext":"%s"}\n' "$msg"
